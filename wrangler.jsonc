{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vfitly",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vfitly"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://www.vfitly.com",
    "NEXT_PUBLIC_APP_URL": "https://www.vfitly.com",
    "STORAGE_PROVIDER": "r2",
    "R2_BUCKET_NAME": "vfitly-assets",
    "R2_PUBLIC_BASE_URL": "https://assets.vfitly.com"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vfitly-assets"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vfitly-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "preview_urls": true
}
